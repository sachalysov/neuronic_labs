# Пример конфигурации Nginx для оптимизации производительности
# Скопируйте эти директивы в конфигурацию вашего Nginx сервера

server {
    listen 80;
    server_name neuroniclabs.ru;
    root /var/www/neuroniclabs/dist;
    index index.html;

    # Сжатие GZIP (оптимизация: уменьшает размер передаваемых данных)
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml;
    gzip_comp_level 6;

    # Сжатие Brotli (если модуль установлен - лучше чем GZIP)
    # brotli on;
    # brotli_comp_level 6;
    # brotli_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml;

    # Cache-Control заголовки для статических ресурсов (оптимизация кэширования)
    location ~* \.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Прокси Yandex Metrika: длинный кеш (Lighthouse — эффективный период хранения кеша)
    location /metrika/ {
        proxy_pass https://mc.yandex.ru/metrika/;
        proxy_ssl_server_name on;
        proxy_set_header Host mc.yandex.ru;
        add_header Cache-Control "public, max-age=604800";  # 7 дней
    }

    # Cache-Control для JS и CSS (с хэшем в имени файла)
    location ~* \.(js|css)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # HTML файлы без кэширования
    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "public, max-age=0, must-revalidate";
    }

    # Preload для критических ресурсов
    location = /index.html {
        add_header Link "</assets/index-*.css>; rel=preload; as=style";
        add_header Link "</assets/index-*.js>; rel=preload; as=script";
    }

    # Определение поисковых ботов и отдача pre-rendered HTML
    # Для ботов сначала проверяем наличие pre-rendered версии
    set $prerender 0;
    if ($http_user_agent ~* (googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|sogou|exabot|facebot|ia_archiver|facebookexternalhit|twitterbot|rogerbot|linkedinbot|embedly|quora|showyoubot|outbrain|pinterest|slackbot|vkShare|W3C_Validator)) {
        set $prerender 1;
    }
    
    # Для ботов: проверяем наличие pre-rendered версии
    location / {
        # Если это бот и существует pre-rendered версия
        if ($prerender = 1) {
            try_files $uri $uri/index.html /index.html;
        }
        # Для обычных пользователей - стандартный SPA routing
        try_files $uri $uri/ /index.html;
    }

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
}

